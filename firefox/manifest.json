{
  "manifest_version": 2,
  "name": "Starlink Obligations Patcher",
  "version": "2.0.0",
  "description": "Modifie la reponse de /api/accounts/v1/accounts/customer-details/obligations sur starlink.com (verificationState + isRestricted).",
  "browser_specific_settings": {
    "gecko": {
      "id": "starlink-obligations-patcher@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "https://starlink.com/*",
    "https://*.starlink.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Obligations Patcher"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
